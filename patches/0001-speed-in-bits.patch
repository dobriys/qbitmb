+    // qbitmb: speed can be shown in bits per second (decimal units, like ISPs use)
+    const isSpeedInBits = () => {
+        const clientData = window.qBittorrent.ClientData ?? window.parent?.qBittorrent?.ClientData;
+        return clientData?.get("qbitmb_speed_in_bits") === true;
+    };
+
+    const friendlyBitSpeed = (bytesPerSecond) => {
+        const units = [
+            "QBT_TR(bit)QBT_TR[CONTEXT=qbitmb]",
+            "QBT_TR(kbit)QBT_TR[CONTEXT=qbitmb]",
+            "QBT_TR(Mbit)QBT_TR[CONTEXT=qbitmb]",
+            "QBT_TR(Gbit)QBT_TR[CONTEXT=qbitmb]",
+            "QBT_TR(Tbit)QBT_TR[CONTEXT=qbitmb]"
+        ];
+
+        let value = bytesPerSecond * 8;
+        let i = 0;
+        while ((value >= 1000) && (i < (units.length - 1))) {
+            value /= 1000;
+            ++i;
+        }
+
+        // Don't round up
+        const number = (i === 0) ? `${value}` : toFixedPointString(value, ((i <= 2) ? 1 : 2));
+        return `${number} ${units[i]}QBT_TR(/s)QBT_TR[CONTEXT=misc]`;
+    };
+
