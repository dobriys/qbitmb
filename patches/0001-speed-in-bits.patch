+    // qbitmb: speed can be shown in bits per second (decimal units, like ISPs use)
+    const isSpeedInBits = () => {
+        const clientData = window.qBittorrent.ClientData ?? window.parent?.qBittorrent?.ClientData;
+        return clientData?.get("qbitmb_speed_in_bits") === true;
+    };
+
+    const friendlyBitSpeed = (bytesPerSecond) => {
+        const units = [
+            "QBT_TR(bit)QBT_TR[CONTEXT=qbitmb]",
+            "QBT_TR(kbit)QBT_TR[CONTEXT=qbitmb]",
+            "QBT_TR(Mbit)QBT_TR[CONTEXT=qbitmb]",
+            "QBT_TR(Gbit)QBT_TR[CONTEXT=qbitmb]",
+            "QBT_TR(Tbit)QBT_TR[CONTEXT=qbitmb]"
+        ];
+
+        // Round to nearest, so that a 50 Mbit/s limit reads "50.0" and not "49.9";
+        // values that would round to 1000 move to the next unit
+        let value = bytesPerSecond * 8;
+        let i = 0;
+        while ((value >= 999.95) && (i < (units.length - 1))) {
+            value /= 1000;
+            ++i;
+        }
+
+        const number = (i === 0) ? `${value}` : value.toFixed((i <= 2) ? 1 : 2);
+        return `${number} ${units[i]}QBT_TR(/s)QBT_TR[CONTEXT=misc]`;
+    };
+
+    // qbitmb: speed limit inputs take Mbit/s instead of KiB/s when speed is shown in bits.
+    // qBittorrent keeps limits in whole KiB, so round to the nearest KiB on the way in
+    // and to 0.01 Mbit on the way out: the typed value then reads back unchanged.
+    const speedLimitFromBytes = (bytes) => {
+        return isSpeedInBits() ? (Math.round(bytes / 1250) / 100) : (bytes / 1024);
+    };
+
+    const speedLimitToBytes = (value) => {
+        return isSpeedInBits() ? (Math.round((value * 125000) / 1024) * 1024) : (value * 1024);
+    };
+
+    const speedLimitUnitText = () => "QBT_TR(Mbit/s)QBT_TR[CONTEXT=qbitmb]";
+
     /*
      * JS counterpart of the function in src/misc.cpp
      */
